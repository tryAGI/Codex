<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds against the published (or locally packed) package, not the project, to check what consumers get. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TryAgiCodexVersion Condition="'$(TryAgiCodexVersion)' == ''">*-*</TryAgiCodexVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="tryAGI.Codex" Version="$(TryAgiCodexVersion)" />
  </ItemGroup>

</Project>
