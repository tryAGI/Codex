<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds against the published (or locally packed) package, not the project, to check what consumers get.
       -p:UseLocalProject=true builds against src/libs instead (scripts/run-authenticated-live-tests.sh). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TryAgiCodexVersion Condition="'$(TryAgiCodexVersion)' == ''">*-*</TryAgiCodexVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalProject)' != 'true'">
    <PackageReference Include="tryAGI.Codex" Version="$(TryAgiCodexVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalProject)' == 'true'">
    <ProjectReference Include="../../src/libs/tryAGI.Codex/tryAGI.Codex.csproj" />
  </ItemGroup>

</Project>
