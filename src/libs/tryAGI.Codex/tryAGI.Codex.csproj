<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>tryAGI.Codex</AssemblyName>
    <RootNamespace>tryAGI.Codex</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="Nuget">
    <PackageId>tryAGI.Codex</PackageId>
    <Description>Native C# client for the OpenAI Codex protocols (Responses agent loop, realtime voice, compaction, apply_patch, device sign-in and the App Server thread/turn RPC surface). Runs the protocol in-process: no codex executable or App Server process is required.</Description>
    <PackageTags>codex;openai;chatgpt;agent;realtime;responses;app-server;json-rpc;sdk;client</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="ProtocolBaseline.json" LogicalName="tryAGI.Codex.ProtocolBaseline.json" />
    <EmbeddedResource Include="AppServerProtocol.json" LogicalName="tryAGI.Codex.AppServerProtocol.json" />
    <InternalsVisibleTo Include="tryAGI.Codex.Tests" Key="" />
  </ItemGroup>

</Project>
